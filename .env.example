# WWV Data Engine - example environment.
# Copy to .env.local and adjust. Never commit a filled-in copy.

# --- Server ---
PORT=5000
NODE_ENV=production

# --- WebSocket ticket auth (ADR-001B) ---
# 'true' lets /stream accept unauthenticated connections. Intended for local and
# offline deployments that run their own engine; never enable it on a deployment
# serving data you pay for.
WWV_SKIP_WS_AUTH=false
# JWKS endpoint of the marketplace that mints your tickets. Required whenever
# WWV_SKIP_WS_AUTH is not 'true': the engine refuses to boot without it.
JWKS_URL=https://marketplace.worldwideview.dev/api/auth/jwks
# Issuer claim your tickets carry. Must match the minting marketplace.
JWT_ISSUER=https://marketplace.worldwideview.dev
# Audience this engine answers to. Every engine also accepts the broadcast
# audience 'wwv-data-engines'.
ENGINE_ID=wwv-data-engine

# --- Origin allowlist ---
# Comma-separated origins allowed to open /stream. Unset means any origin, which
# is logged as a warning at boot in production.
ALLOWED_ORIGINS=https://cloud-wwv.dev,https://demo.worldwideview.dev

# --- Connection limits ---
WS_MESSAGE_RATE_LIMIT=60
WS_MESSAGE_RATE_LIMIT_WINDOW_MS=10000

# --- Data sources ---
# 'true' downloads the latest seeder packages at boot.
DOWNLOAD_SEEDERS=false

# --- Observability (optional) ---
SENTRY_DSN=
