# Redis connection (required)
REDIS_URL=redis://localhost:6379

# Server port (default: 5000)
PORT=5000

# Seeders sync at startup
# -----------------------
# When true the engine downloads and installs the latest seeder releases on
# boot (community + private). When unset or false it serves only what is
# already on disk. Health probes: GET /health always returns 200;
# GET /health/seeders returns 200 when the last sync succeeded AND
# mergedCount > 0, otherwise 503 with { ok: false, reason } where reason is
# 'download-disabled' | 'not-attempted' | 'sync-failed'.
# DOWNLOAD_SEEDERS=true

# PAT required for the PRIVATE seeder repo. When absent the private repo is
# skipped (error 'no GITHUB_PAT') and the sync is still OK as long as the
# community repo succeeded.
# GITHUB_PAT=github_pat_xxxx

# Override the seeder source repos (defaults shown), owner/repo format.
# COMMUNITY_SEEDERS_REPO=silvertakana/wwv-seeders
# PRIVATE_SEEDERS_REPO=silvertakana/wwv-seeders-private

# Seeder data-source API keys; seeders read these at runtime and a missing key
# makes the affected seeder fail per run (see seeder health telemetry).
# GFW_GLAD_API_KEY=your_key_here
# OPENAQ_API_KEY=your_key_here
# AISSTREAM_API_KEY=your_key_here

# Optional: AlienVault OTX API key for cyber attacks seeder
# Get a free key at https://otx.alienvault.com
# OTX_API_KEY=your_key_here

# Optional: Supabase/Postgres URL for historical data sync
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Optional: Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Optional: Restrict CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://worldwideview.dev

# WebSocket JWT auth (ADR-001 — required for production)
# JWKS endpoint served by worldwideview-marketplace /api/auth/jwks
JWKS_URL=https://marketplace.worldwideview.dev

# Optional: engine identity claim in JWTs (default: wwv-data-engine)
# ENGINE_ID=wwv-data-engine

# Dev bypass: set to true to skip WebSocket JWT verification entirely
# MUST be unset or false in production — enforces ADR-001 auth
# WWV_SKIP_WS_AUTH=true
