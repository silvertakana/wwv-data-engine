# Redis connection (required)
REDIS_URL=redis://localhost:6379

# Server port (default: 5001)
PORT=5001

# Optional: AlienVault OTX API key for cyber attacks seeder
# Get a free key at https://otx.alienvault.com
# OTX_API_KEY=your_key_here

# Optional: Supabase/Postgres URL for historical data sync
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Optional: Sentry DSN for error tracking
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# Optional: Restrict CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,https://worldwideview.dev
